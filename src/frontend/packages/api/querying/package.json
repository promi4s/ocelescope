{
  "name": "@ocelescope/api-querying",
  "type": "module",
  "version": "0.1.0",
  "description": "Generated, type-safe client and hooks for the Ocelescope querying backend module.",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "orval && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "generate:api": "uv run ocelescope-backend openapi --module querying --path ./openapi.json"
  },
  "peerDependencies": {
    "@ocelescope/api-client": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@ocelescope/api-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "orval": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
