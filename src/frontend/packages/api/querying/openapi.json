{
  "openapi": "3.1.0",
  "info": {
    "title": "OCEL Querying",
    "version": "1.0"
  },
  "paths": {
    "/modules/querying/v1/{ocel_id}/schema": {
      "get": {
        "summary": "Ocel Schema",
        "operationId": "ocelSchema",
        "parameters": [
          {
            "name": "ocel_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ocel Id"
            }
          },
          {
            "name": "ocel_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "original",
                    "filtered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "filtered",
              "title": "Ocel Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcelSchemaResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/modules/querying/v1/{ocel_id}/query": {
      "post": {
        "summary": "Ocel Query",
        "operationId": "ocelQuery",
        "parameters": [
          {
            "name": "ocel_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ocel Id"
            }
          },
          {
            "name": "ocel_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "original",
                    "filtered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "filtered",
              "title": "Ocel Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OcelQueryBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcelQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NumericBinSchema": {
        "properties": {
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Count"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          }
        },
        "type": "object",
        "title": "NumericBinSchema"
      },
      "OcelFieldSchema": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "string",
              "boolean",
              "datetime",
              "unknown"
            ],
            "title": "Type"
          },
          "role": {
            "type": "string",
            "enum": [
              "id",
              "type",
              "timestamp",
              "qualifier",
              "attribute",
              "technical"
            ],
            "title": "Role"
          },
          "nullable": {
            "type": "boolean",
            "title": "Nullable"
          },
          "entity_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entity Types"
          },
          "types_by_entity": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "number",
                "string",
                "boolean",
                "datetime",
                "unknown"
              ]
            },
            "type": "object",
            "title": "Types By Entity"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "role",
          "nullable",
          "entity_types",
          "types_by_entity"
        ],
        "title": "OcelFieldSchema"
      },
      "OcelQueryBody": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "events",
              "objects",
              "e2o",
              "o2o",
              "object_changes"
            ],
            "title": "Source"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Fields"
          },
          "filters": {
            "items": {
              "$ref": "#/components/schemas/QueryFilterSchema"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Filters"
          },
          "group_by": {
            "items": {
              "$ref": "#/components/schemas/QueryGroupSchema"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Group By"
          },
          "measures": {
            "items": {
              "$ref": "#/components/schemas/QueryMeasureSchema"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Measures"
          },
          "order_by": {
            "items": {
              "$ref": "#/components/schemas/QueryOrderSchema"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Order By"
          },
          "limit": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 1000
          }
        },
        "type": "object",
        "required": [
          "source"
        ],
        "title": "OcelQueryBody"
      },
      "OcelQueryResponse": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/QueryColumnSchema"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "stats": {
            "$ref": "#/components/schemas/QueryStatsSchema"
          }
        },
        "type": "object",
        "required": [
          "columns",
          "rows",
          "stats"
        ],
        "title": "OcelQueryResponse"
      },
      "OcelSchemaResponse": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/OcelSourceSchema"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "sources"
        ],
        "title": "OcelSchemaResponse"
      },
      "OcelSourceSchema": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "events",
              "objects",
              "e2o",
              "o2o",
              "object_changes"
            ],
            "title": "Name"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/OcelFieldSchema"
            },
            "type": "array",
            "title": "Fields"
          },
          "entity_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entity Types"
          },
          "id_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id Field"
          },
          "type_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type Field"
          },
          "timestamp_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp Field"
          }
        },
        "type": "object",
        "required": [
          "name",
          "row_count",
          "fields",
          "entity_types",
          "id_field",
          "type_field",
          "timestamp_field"
        ],
        "title": "OcelSourceSchema"
      },
      "QueryColumnSchema": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "string",
              "boolean",
              "datetime",
              "unknown"
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "QueryColumnSchema"
      },
      "QueryFilterSchema": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "neq",
              "in",
              "not_in",
              "lt",
              "lte",
              "gt",
              "gte",
              "between",
              "contains",
              "is_null",
              "not_null"
            ],
            "title": "Operator"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "field",
          "operator"
        ],
        "title": "QueryFilterSchema"
      },
      "QueryGroupSchema": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Alias"
          },
          "bin": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NumericBinSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "time_unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "minute",
                  "hour",
                  "day",
                  "week",
                  "month",
                  "quarter",
                  "year"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Unit"
          }
        },
        "type": "object",
        "required": [
          "field",
          "alias"
        ],
        "title": "QueryGroupSchema"
      },
      "QueryMeasureSchema": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "count",
              "count_distinct",
              "sum",
              "avg",
              "min",
              "max",
              "median"
            ],
            "title": "Operation"
          },
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Alias"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "operation",
          "alias"
        ],
        "title": "QueryMeasureSchema"
      },
      "QueryOrderSchema": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "title": "Direction",
            "default": "asc"
          }
        },
        "type": "object",
        "required": [
          "field"
        ],
        "title": "QueryOrderSchema"
      },
      "QueryStatsSchema": {
        "properties": {
          "source_rows": {
            "type": "integer",
            "title": "Source Rows"
          },
          "filtered_rows": {
            "type": "integer",
            "title": "Filtered Rows"
          },
          "matched_rows": {
            "type": "integer",
            "title": "Matched Rows"
          },
          "result_rows": {
            "type": "integer",
            "title": "Result Rows"
          },
          "returned_rows": {
            "type": "integer",
            "title": "Returned Rows"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          }
        },
        "type": "object",
        "required": [
          "source_rows",
          "filtered_rows",
          "matched_rows",
          "result_rows",
          "returned_rows",
          "truncated"
        ],
        "title": "QueryStatsSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}