    "dayjs": "catalog:",
    "elkjs": "catalog:",
    "file-saver": "catalog:",
    "lucide-react": "catalog:",
    "mantine-datatable": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-plotly.js": "catalog:",
    "react-zoom-pan-pinch": "catalog:"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "@types/file-saver": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
