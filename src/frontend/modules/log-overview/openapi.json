{
  "openapi": "3.1.0",
  "info": {
    "title": "Exploration",
    "version": "1.0"
  },
  "paths": {
    "/modules/exploration/v1/{ocel_id}/events/attributes": {
      "get": {
        "summary": "Event Attributes",
        "operationId": "eventAttributes",
        "parameters": [
          {
            "name": "ocel_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ocel Id"
            }
          },
          {
            "name": "ocel_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "original",
                    "filtered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "filtered",
              "title": "Ocel Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/AttributeInfoSchema"
                    }
                  },
                  "title": "Response Eventattributes"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/modules/exploration/v1/{ocel_id}/events/{event_type}/{attribute}/histogram": {
      "post": {
        "summary": "Event Attribute Histogram",
        "operationId": "eventAttributeHistogram",
        "parameters": [
          {
            "name": "event_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Type"
            }
          },
          {
            "name": "attribute",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Attribute"
            }
          },
          {
            "name": "ocel_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ocel Id"
            }
          },
          {
            "name": "ocel_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "original",
                    "filtered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "filtered",
              "title": "Ocel Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistogramBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistogramSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/modules/exploration/v1/{ocel_id}/events/{event_type}/{attribute}/instances": {
      "post": {
        "summary": "Event Attribute Instances",
        "operationId": "eventAttributeInstances",
        "parameters": [
          {
            "name": "event_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Type"
            }
          },
          {
            "name": "attribute",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Attribute"
            }
          },
          {
            "name": "ocel_id",
            "in": "path",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ocel Id"
            }
          },
          {
            "name": "ocel_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "original",
                    "filtered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "filtered",
              "title": "Ocel Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventInstancesBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventInstancesSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttributeInfoSchema": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "numeric",
              "categorical"
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "AttributeInfoSchema"
      },
      "EventInstanceSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "value"
        ],
        "title": "EventInstanceSchema"
      },
      "EventInstancesBody": {
        "properties": {
          "range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RangeInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 100
          }
        },
        "type": "object",
        "title": "EventInstancesBody"
      },
      "EventInstancesSchema": {
        "properties": {
          "instances": {
            "items": {
              "$ref": "#/components/schemas/EventInstanceSchema"
            },
            "type": "array",
            "title": "Instances"
          },
          "matching_count": {
            "type": "integer",
            "title": "Matching Count"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          }
        },
        "type": "object",
        "required": [
          "instances",
          "matching_count",
          "truncated"
        ],
        "title": "EventInstancesSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistogramBinSchema": {
        "properties": {
          "start": {
            "type": "number",
            "title": "Start"
          },
          "end": {
            "type": "number",
            "title": "End"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "count"
        ],
        "title": "HistogramBinSchema"
      },
      "HistogramBody": {
        "properties": {
          "range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RangeInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "bins": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bins"
          }
        },
        "type": "object",
        "title": "HistogramBody"
      },
      "HistogramCountsSchema": {
        "properties": {
          "covered": {
            "type": "integer",
            "title": "Covered"
          },
          "missing": {
            "type": "integer",
            "title": "Missing"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "covered",
          "missing",
          "total"
        ],
        "title": "HistogramCountsSchema"
      },
      "HistogramSchema": {
        "properties": {
          "bins": {
            "items": {
              "$ref": "#/components/schemas/HistogramBinSchema"
            },
            "type": "array",
            "title": "Bins"
          },
          "domain": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RangeSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "covered": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RangeSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "counts": {
            "$ref": "#/components/schemas/HistogramCountsSchema"
          }
        },
        "type": "object",
        "required": [
          "bins",
          "domain",
          "covered",
          "counts"
        ],
        "title": "HistogramSchema"
      },
      "RangeInput": {
        "properties": {
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          }
        },
        "type": "object",
        "title": "RangeInput",
        "description": "Request range. Either endpoint may be omitted for an open range."
      },
      "RangeSchema": {
        "properties": {
          "min": {
            "type": "number",
            "title": "Min"
          },
          "max": {
            "type": "number",
            "title": "Max"
          }
        },
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "title": "RangeSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}