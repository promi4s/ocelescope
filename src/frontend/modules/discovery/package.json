    "@ocelescope/api-base": "workspace:^",
    "@ocelescope/core": "workspace:^",
    "@ocelescope/resources": "workspace:^",
    "@rjsf/core": "catalog:",
    "@rjsf/mantine": "catalog:",
    "@rjsf/utils": "catalog:",
    "@rjsf/validator-ajv8": "catalog:",
    "@tanstack/react-query": "catalog:",
    "embla-carousel": "catalog:",
    "embla-carousel-react": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "uniqolor": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@rjsf/mantine": "catalog:",
    "@types/file-saver": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
