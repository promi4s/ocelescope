{
  "openapi": "3.1.0",
  "info": {
    "title": "Exploration",
    "version": "1.0"
  },
  "paths": {
    "/modules/exploration/v1/ocels/{ocel_id}/queries": {
      "post": {
        "tags": [
          "exploration"
        ],
        "summary": "Run Query",
        "description": "Run the analysis named by the body's `analysis` field.",
        "operationId": "runQuery",
        "parameters": [
          {
            "name": "ocel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ocel Id"
            }
          },
          {
            "name": "ocel_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "original",
                    "filtered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "filtered",
              "title": "Ocel Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/EventAttributeDistribution"
                  },
                  {
                    "$ref": "#/components/schemas/ObjectAttributeDistribution"
                  },
                  {
                    "$ref": "#/components/schemas/ObjectInvolvementDistribution"
                  },
                  {
                    "$ref": "#/components/schemas/TimeBetweenActivities"
                  },
                  {
                    "$ref": "#/components/schemas/TotalObjectInvolvement"
                  },
                  {
                    "$ref": "#/components/schemas/ObjectCountsPerEvent"
                  },
                  {
                    "$ref": "#/components/schemas/ObjectTypeCombinations"
                  },
                  {
                    "$ref": "#/components/schemas/ActivityExecutionFrequency"
                  },
                  {
                    "$ref": "#/components/schemas/ObjectActivityExecutionDistribution"
                  },
                  {
                    "$ref": "#/components/schemas/ObjectAttributeTimeline"
                  }
                ],
                "discriminator": {
                  "propertyName": "analysis",
                  "mapping": {
                    "event-attribute-distribution": "#/components/schemas/EventAttributeDistribution",
                    "object-attribute-distribution": "#/components/schemas/ObjectAttributeDistribution",
                    "object-involvement-distribution": "#/components/schemas/ObjectInvolvementDistribution",
                    "time-between-activities": "#/components/schemas/TimeBetweenActivities",
                    "total-object-involvement": "#/components/schemas/TotalObjectInvolvement",
                    "object-counts-per-event": "#/components/schemas/ObjectCountsPerEvent",
                    "object-type-combinations": "#/components/schemas/ObjectTypeCombinations",
                    "activity-execution-frequency": "#/components/schemas/ActivityExecutionFrequency",
                    "object-activity-execution-distribution": "#/components/schemas/ObjectActivityExecutionDistribution",
                    "object-attribute-timeline": "#/components/schemas/ObjectAttributeTimeline"
                  }
                },
                "title": "Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityExecutionFrequency": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "activity-execution-frequency",
            "title": "Analysis"
          },
          "object_type": {
            "type": "string",
            "title": "Object Type"
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "object_type"
        ],
        "title": "ActivityExecutionFrequency",
        "description": "Objects of a type by how often they executed each activity, in bands."
      },
      "Bins": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "bins",
            "title": "Kind"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 200.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Bins"
      },
      "Categories": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "categories",
            "title": "Kind"
          },
          "limit": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 50
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Categories"
      },
      "EventAttributeDistribution": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "event-attribute-distribution",
            "title": "Analysis"
          },
          "activity": {
            "type": "string",
            "title": "Activity"
          },
          "attribute": {
            "type": "string",
            "title": "Attribute"
          },
          "grouping": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Categories"
              },
              {
                "$ref": "#/components/schemas/Bins"
              }
            ],
            "title": "Grouping",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "bins": "#/components/schemas/Bins",
                "categories": "#/components/schemas/Categories"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "activity",
          "attribute",
          "grouping"
        ],
        "title": "EventAttributeDistribution",
        "description": "An event attribute's values, one per event of an activity."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObjectActivityExecutionDistribution": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "object-activity-execution-distribution",
            "title": "Analysis"
          },
          "object_type": {
            "type": "string",
            "title": "Object Type"
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "object_type"
        ],
        "title": "ObjectActivityExecutionDistribution",
        "description": "Exact execution counts per object, for activities some object repeats."
      },
      "ObjectAttributeDistribution": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "object-attribute-distribution",
            "title": "Analysis"
          },
          "activity": {
            "type": "string",
            "title": "Activity"
          },
          "object_type": {
            "type": "string",
            "title": "Object Type"
          },
          "attribute": {
            "type": "string",
            "title": "Attribute"
          },
          "grouping": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Categories"
              },
              {
                "$ref": "#/components/schemas/Bins"
              }
            ],
            "title": "Grouping",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "bins": "#/components/schemas/Bins",
                "categories": "#/components/schemas/Categories"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "activity",
          "object_type",
          "attribute",
          "grouping"
        ],
        "title": "ObjectAttributeDistribution",
        "description": "An object attribute's value at each event of an activity, one per\nevent-object pair. A change at the event's own timestamp already applies."
      },
      "ObjectAttributeTimeline": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "object-attribute-timeline",
            "title": "Analysis"
          },
          "object_id": {
            "type": "string",
            "title": "Object Id"
          },
          "attributes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attributes"
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "object_id"
        ],
        "title": "ObjectAttributeTimeline",
        "description": "Every attribute change of an object and every event it takes part in,\nin time order, each with the attribute values in effect at that point."
      },
      "ObjectCountsPerEvent": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "object-counts-per-event",
            "title": "Analysis"
          },
          "activities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Activities"
          }
        },
        "type": "object",
        "required": [
          "analysis"
        ],
        "title": "ObjectCountsPerEvent",
        "description": "Events by how many distinct objects of each type they involve."
      },
      "ObjectInvolvementDistribution": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "object-involvement-distribution",
            "title": "Analysis"
          },
          "activity": {
            "type": "string",
            "title": "Activity"
          },
          "object_type": {
            "type": "string",
            "title": "Object Type"
          },
          "grouping": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Categories"
              },
              {
                "$ref": "#/components/schemas/Bins"
              }
            ],
            "title": "Grouping",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "bins": "#/components/schemas/Bins",
                "categories": "#/components/schemas/Categories"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "activity",
          "object_type",
          "grouping"
        ],
        "title": "ObjectInvolvementDistribution",
        "description": "Distinct objects of a type per event of an activity, including zero."
      },
      "ObjectTypeCombinations": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "object-type-combinations",
            "title": "Analysis"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 15
          },
          "activities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Activities"
          }
        },
        "type": "object",
        "required": [
          "analysis"
        ],
        "title": "ObjectTypeCombinations",
        "description": "The most frequent exact sets of object types per event, by activity."
      },
      "Result": {
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          }
        },
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "Result",
        "description": "What every analysis returns: tidy rows, plus named population figures."
      },
      "TimeBetweenActivities": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "time-between-activities",
            "title": "Analysis"
          },
          "source_activity": {
            "type": "string",
            "title": "Source Activity"
          },
          "target_activity": {
            "type": "string",
            "title": "Target Activity"
          },
          "object_type": {
            "type": "string",
            "title": "Object Type"
          },
          "unit": {
            "type": "string",
            "enum": [
              "seconds",
              "minutes",
              "hours",
              "days"
            ],
            "title": "Unit"
          },
          "bin_count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 200.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bin Count"
          }
        },
        "type": "object",
        "required": [
          "analysis",
          "source_activity",
          "target_activity",
          "object_type",
          "unit"
        ],
        "title": "TimeBetweenActivities",
        "description": "Durations from a source to a directly following target activity, once\neach object's trace is reduced to just those two activities."
      },
      "TotalObjectInvolvement": {
        "properties": {
          "analysis": {
            "type": "string",
            "const": "total-object-involvement",
            "title": "Analysis"
          }
        },
        "type": "object",
        "required": [
          "analysis"
        ],
        "title": "TotalObjectInvolvement",
        "description": "Events by how many distinct objects they involve, per activity.\nEvents without any object count as involving zero."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}