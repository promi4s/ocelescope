{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ocelescope/resources": [
        "../packages/resources/src/index.ts"
      ],
      "@ocelescope/discovery": [
        "../modules/discovery/src/index.ts"
      ],
      "@ocelescope/management": [
        "../modules/management/src/index.ts"
      ],
      "@ocelescope/filter": [
        "../modules/filter/src/index.ts"
      ],
      "@ocelescope/plugin": [
        "../modules/plugin/src/index.ts"
      ],
      "@ocelescope/log-overview": [
        "../modules/log-overview/src/index.ts"
      ],
      "@ocelescope/variants": [
        "../modules/variants/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
