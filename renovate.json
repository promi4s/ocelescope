{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Berlin",
  "extends": ["config:best-practices", "group:monorepos", "group:recommended"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "commitMessagePrefix": ":arrow_up: ",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "next 16.3.1 ships a broken `output: standalone` bundle under pnpm (@swc/helpers esm/ is not traced); fixed in canary, so allow 16.3.2+",
      "matchPackageNames": ["next"],
      "allowedVersions": "<16.3.1 || >16.3.1"
    },
    {
      "description": "TypeScript 7 has no stable compiler API yet (tsdown) and is outside typedoc's peer range",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
